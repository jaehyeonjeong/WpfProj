<Window x:Class="MatchGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MatchGame"
        mc:Ignorable="d"
        Title="Find all of the matching animals" Height="450" Width="400">
    <Grid x:Name="mainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="0" Grid.Column="0" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="0" Grid.Column="1" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="0" Grid.Column="2" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="0" Grid.Column="3" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="1" Grid.Column="0" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="1" Grid.Column="1" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="1" Grid.Column="2" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="1" Grid.Column="3" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="2" Grid.Column="0" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="2" Grid.Column="1" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="2" Grid.Column="2" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="2" Grid.Column="3" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="3" Grid.Column="0" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="3" Grid.Column="1" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="3" Grid.Column="2" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="?" Grid.Row="3" Grid.Column="3" FontSize="36" FontFamily="Segoe UI" Cursor="Hand" MouseDown="TextBlock_MouseDown"/>
    </Grid>
    <!--<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock FontSize="18px" Text="XAML helps you design great user interfaces."/>
        <Button Width="50" Margin="5, 10" Content="I agree"/>
    </StackPanel>-->
</Window>
